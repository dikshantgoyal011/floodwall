{
  "name": "floodwall-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "check": "npm run typecheck && npm run test",
    "migrate:local": "wrangler d1 migrations apply floodwall-auth --local",
    "migrate:remote": "wrangler d1 migrations apply floodwall-auth --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "miniflare": "5.20261019.1-beta",
    "typescript": "^5.9.3",
    "wrangler": "4.151.3"
  }
}
