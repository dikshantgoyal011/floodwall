{
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "types": ["node"],
    "strict": true
  },
  "include": ["vite.config.ts", "crate-stats.mjs", "structured-data.mjs", "src/content.ts"]
}
